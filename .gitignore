node_modules/

# Frontend build output, embedded into the binary by web/embed.go. The
# directory itself must stay in git or //go:embed has nothing to match.
web/dist/*
!web/dist/.gitkeep

# Compiled binaries. `make` produces overland; older builds used the project
# name instead.
/overland
/gpx-editor
/overland-gpx-editor
/build/
/playwright-report/
/test-results/

# Your track library. Never commit this: GPX files are a log of where you have
# physically been, timestamped.
gpx/

# Cached terrain tiles (-elevation-tile-cache). Tens of MB of upstream data,
# rebuildable on demand.
tiles/

.env
.env.*
!.env.example

# Local tooling state — machine paths, not project config
.octmp/
.claude/settings.local.json
.venv/
__pycache__/
.kata.local.toml
