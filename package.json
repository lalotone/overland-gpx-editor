{
  "name": "gpx-editor",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run clean && vite build",
    "clean": "node -e \"require('fs').rmSync('web/dist/assets',{recursive:true,force:true})\"",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/verify.mjs && node node_modules/.cache/verify.mjs && npm run verify:mcp",
    "verify:mcp": "esbuild scripts/verifyMcpBridge.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/verifyMcpBridge.mjs && node node_modules/.cache/verifyMcpBridge.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.21.5",
    "eslint": "^10.0.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.2.2",
    "vite": "^5.0.8"
  }
}
