# Copy to .env and adjust. Everything here has a working default, so the app
# runs without this file — you only need it to point at your own services.

# ---------------------------------------------------------------------------
# Frontend (Vite). Only VITE_-prefixed vars reach the browser bundle.
# ---------------------------------------------------------------------------

# Backend API base URL. Empty (the default) means "same origin", which is what
# you want when the Go binary serves the frontend, and what `npm run dev`
# wants too — it proxies the API paths to VITE_DEV_API_TARGET. Set this only
# to point the app at a backend on another host.
VITE_API_BASE=

# Where `npm run dev` proxies /files, /gpx, /upload and /elevation.
VITE_DEV_API_TARGET=http://localhost:8000

# Optional opentopodata address the browser calls directly if the backend
# proxy fails. Empty disables the fallback, which is right when the backend is
# the thing serving the page. Must be reachable from the browser if set.
VITE_ELEVATION_API=

# DEM dataset name, passed through to the elevation service as /v1/<dataset>.
# srtm30m is a good default; srtm90m smooths out trail gradients.
VITE_ELEVATION_DATASET=srtm30m

# ---------------------------------------------------------------------------
# Backend (the Go binary). Read from the process environment, not from Vite.
# Each one also has a flag, which wins — see `gpx-editor -h`.
# ---------------------------------------------------------------------------

# Address to listen on (flag: -addr).
ADDR=:8000

# Track library directory (flag: -gpx-dir).
GPX_DIR=gpx

# Self-hosted opentopodata-style DEM (flag: -elevation-host). Leave empty to
# use the public Open-Meteo API, which needs no setup but serves Copernicus
# 90 m — set this to a 30 m service if you care about slope accuracy.
ELEVATION_HOST=

# Dataset for ELEVATION_HOST when a request names none (-elevation-dataset).
# Ignored by Open-Meteo, which serves one dataset.
ELEVATION_DATASET=srtm30m
