---context:global
assign validForFoot = 0
assign validForBikes = 0
assign validForCars = 1
assign overland_access_permit = 0 # %overland_access_permit% | Rider has permission for restricted ways and gates | boolean
assign considerTurnRestrictions = 1
assign continueStraight = 0
assign waypointCatchingRange = 100
assign processUnusedTags = 0
assign paved_factor = 6
assign unknown_road_factor = 4
assign unknown_track_factor = 1.5
assign hard_factor = 0.5
assign uphillcost = 8
assign uphillcutoff = 1.5
assign uphillmaxslope = 25
assign uphillmaxslopecost = 40
assign downhillcost = 3
assign downhillcutoff = 2
assign downhillmaxslope = 30
assign downhillmaxslopecost = 25
assign elevationpenaltybuffer = 5
assign elevationmaxbuffer = 10
assign elevationbufferreduce = 0.2

---context:way
assign defaultaccess = if access= then true else access=yes|permissive|designated
assign vehicleaccess = if vehicle= then defaultaccess else vehicle=yes|permissive|designated
assign motoraccess = if motor_vehicle= then vehicleaccess else motor_vehicle=yes|permissive|designated
assign motorcycleaccess = if motorcycle= then motoraccess else motorcycle=yes|permissive|designated
assign explicitmotor = if motorcycle= then if motor_vehicle= then vehicle=yes|permissive|designated else motor_vehicle=yes|permissive|designated else motorcycle=yes|permissive|designated
assign roadclass = highway=motorway|motorway_link|trunk|trunk_link|primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|residential|living_street|unclassified|service|road|track
assign permittedpath = and highway=path|bridleway or explicitmotor overland_access_permit
assign allowed = and or motorcycleaccess overland_access_permit or roadclass or permittedpath route=ferry
assign badoneway = if reversedirection=yes then oneway=yes else oneway=-1

assign paved = surface=asphalt|paved|concrete|paving_stones|cobblestone|sett
assign unpaved = surface=unpaved|ground|dirt|earth|compacted|fine_gravel|gravel|grass|sand|mud|clay|pebblestone
assign basecost =
  if paved then paved_factor
  else if unpaved then 1
  else if highway=track then unknown_track_factor
  else if permittedpath then 1.8
  else unknown_road_factor
assign roadpenalty =
  switch highway=motorway|motorway_link|trunk|trunk_link 25
  switch highway=primary|primary_link 6
  switch highway=secondary|secondary_link 3
  switch highway=tertiary|tertiary_link 1
  switch route=ferry 15
  0
assign roughness =
  switch smoothness=impassable 10000
  switch smoothness=very_horrible 5
  switch smoothness=horrible 2
  switch surface=sand|mud|clay 1.5
  switch tracktype=grade5 1
  switch tracktype=grade4 0.4
  0
assign technical =
  switch mtb:scale=5|6 10
  switch mtb:scale=4 4
  switch mtb:scale=3 1.5
  switch mtb:scale=2 0.4
  0
assign costfactor = if or not allowed or badoneway smoothness=impassable then 10000 else max 1 add basecost add roadpenalty multiply hard_factor add roughness technical
assign uphillcostfactor = costfactor
assign downhillcostfactor = costfactor
assign turncost = 30
assign initialcost = 0
assign nodeaccessgranted = false
assign priorityclassifier = switch highway=track 3 switch permittedpath 2 1

assign roadspeed =
  switch highway=motorway|motorway_link|trunk|trunk_link 70
  switch highway=primary|primary_link 60
  switch highway=secondary|secondary_link 50
  switch highway=tertiary|tertiary_link 40
  switch highway=residential|unclassified 30
  switch highway=living_street 10
  switch highway=track 25
  switch permittedpath 12
  20
assign surfacespeed =
  switch paved 80
  switch surface=compacted|fine_gravel 30
  switch surface=gravel|ground|dirt|earth|unpaved 22
  switch surface=sand|grass 12
  switch surface=mud|clay 8
  20
assign trackspeed = switch tracktype=grade5 10 switch tracktype=grade4 15 switch tracktype=grade3 22 80
assign legalspeed =
  switch maxspeed=10 5
  switch maxspeed=20 16
  switch maxspeed=30 30
  switch maxspeed=40 40
  switch maxspeed=50 48
  switch maxspeed=60 56
  switch maxspeed=70 70
  switch maxspeed=80 80
  switch maxspeed=90 88
  switch maxspeed=100 96
  switch maxspeed=110 110
  switch maxspeed=120 120
  switch maxspeed=130 130
  130
assign maxspeed = min legalspeed min roadspeed min surfacespeed trackspeed

---context:node
assign defaultaccess = if access= then true else access=yes|permissive|designated
assign vehicleaccess = if vehicle= then defaultaccess else vehicle=yes|permissive|designated
assign motoraccess = if motor_vehicle= then vehicleaccess else motor_vehicle=yes|permissive|designated
assign motorcycleaccess = if motorcycle= then motoraccess else motorcycle=yes|permissive|designated
assign barrierok = or barrier= barrier=no|entrance|cattle_grid|toll_booth
assign permitbarrier = and overland_access_permit barrier=gate|lift_gate|swing_gate|chain
assign initialcost = if and or motorcycleaccess overland_access_permit or barrierok permitbarrier then 0 else 1000000
